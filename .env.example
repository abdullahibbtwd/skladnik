# Copy to `.env` and adjust if needed.
# Values below are for running the API on your machine against dockerized services.

NODE_ENV=development
PORT=3003
WEB_PORT=5176

# --- GLM / Z.AI vision (OCR) ---
# General endpoint: https://api.z.ai/api/paas/v4
# Invoice photos need a multimodal model. glm-5.3 is text-only.
# Paid GLM-5.3-Flash trial package → glm-5.3-flash
# GLM-OCR layout parsing: OCR_ENGINE=layout (keeps vision path when OCR_ENGINE=vision)
GLM_API_KEY=
ZAI_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.3-flash
OCR_ENGINE=vision
# Layout path: OCR_ENGINE=layout — GLM-OCR + local HTML table parse; optional flash header model:
# GLM_LAYOUT_STRUCT_MODEL=glm-4.5-flash
# Reading tuning (defaults measured with apps/api/scripts/bench-extraction.cjs; target <20 s for 1-page):
GLM_REASONING_EFFORT=low
VISION_MAX_EDGE=1600
GLM_COMPACT_OUTPUT=true
# GLM_HEADER_MODEL=            # optional: read header/totals with this model in parallel with the lines

# --- Postgres ---
POSTGRES_USER=skladnik
POSTGRES_PASSWORD=skladnik
POSTGRES_DB=skladnik
POSTGRES_PORT=5432
# Host-based API (`npm run dev`): use localhost.
# API-in-Docker: docker-compose overrides this to postgres:5432.
DATABASE_URL=postgresql://skladnik:skladnik@localhost:5432/skladnik

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
# Host-reachable hostname used in signed URLs (keep localhost even when the API runs in Docker).
MINIO_PUBLIC_ENDPOINT=localhost
# Port/SSL for signed URLs; default to MINIO_PORT / MINIO_USE_SSL. Behind Coolify/Traefik: 443 and true.
# MINIO_PUBLIC_PORT=443
# MINIO_PUBLIC_USE_SSL=true
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_USE_SSL=false
MINIO_BUCKET=invoices

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Platform operator realm (separate cookies + audience from tenant JWT)
JWT_PLATFORM_ACCESS_SECRET=dev-platform-access-secret-change-me-please
JWT_PLATFORM_REFRESH_SECRET=dev-platform-refresh-secret-change-me-please
# Any high-entropy string; hashed to AES-256 key for PlatformAdmin.totpSecret at rest
PLATFORM_TOTP_ENCRYPTION_KEY=dev-platform-totp-encryption-key-change-me
ACTIVATION_CODE_PEPPER=dev-activation-code-pepper-change-me
# AES-256 key material for ActivationCode.codeCiphertext (hashed to 32 bytes; separate from TOTP key)
ACTIVATION_CODE_ENCRYPTION_KEY=dev-activation-code-encryption-key-change-me
# SubscriptionGuard: true (default) = enforce; false = shadow (log only)
SUBSCRIPTION_ENFORCE=true
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5176
# Which proxies may set X-Forwarded-For (login rate limits key on the client IP).
# Default covers Vite/nginx on the same host or Docker network; e.g. set 1 behind a single external load balancer.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Google Identity Services (optional). Client ID is public; leave empty to hide the Google button.
# Create an OAuth 2.0 Client ID (Web) in Google Cloud Console and add WEB_ORIGIN to Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=

# --- Email (invites + password reset) ---
# Use a Resend API key in production. Locally, invite and reset links are logged / returned for development.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Skladnik <beth.t@example.com>

# Copy to `.env` and adjust if needed.
# Values below are for running the API on your machine against dockerized services.

NODE_ENV=development
PORT=3003
WEB_PORT=5176

# --- GLM / Z.AI vision (OCR) ---
# Either key name works. Used by the background document extraction job.
GLM_API_KEY=
ZAI_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5v-turbo

# --- Postgres ---
POSTGRES_USER=skladnik
POSTGRES_PASSWORD=skladnik
POSTGRES_DB=skladnik
POSTGRES_PORT=5432
# Host-based API (`npm run dev`): use localhost.
# API-in-Docker: docker-compose overrides this to postgres:5432.
DATABASE_URL=postgresql://skladnik:skladnik@localhost:5432/skladnik

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=localhost
# Host-reachable hostname used in signed URLs (keep localhost even when the API runs in Docker).
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_USE_SSL=false
MINIO_BUCKET=invoices

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:5176

# --- Email (invites) ---
# Use a Resend API key in production. Locally, invites still create a copyable link.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Skladnik <beth.t@example.com>

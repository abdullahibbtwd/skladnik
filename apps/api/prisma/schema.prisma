generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity (§3)
// Every row below Company is company-scoped. Auth never trusts a companyId
// from the request body — only the JWT / session.
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  SITE_MANAGER
  STAFF
  ACCOUNTANT
}

enum SiteType {
  STORE
  KITCHEN
  BAR
  WAREHOUSE
}

enum PartnerKind {
  SUPPLIER
  CUSTOMER
  BOTH
}

enum DocumentType {
  /// Търговски документ / purchase invoice
  INVOICE
  /// Складова разписка — изписване / goods handover or dispatch
  PROTOCOL
  /// Стокова разписка / goods receipt note
  RECEIPT
  /// Кредитно/дебитно известие
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  REVIEW
  POSTED
  CANCELLED
}

enum StockDirection {
  IN
  OUT
}

enum ProductStatus {
  ACTIVE
  PENDING_REVIEW
  ARCHIVED
}

enum UnitOfMeasure {
  PCS
  PACK
  KG
  CASE
  CARTON
  JAR
  OTHER
}

enum CaptureExtractionStatus {
  IDLE
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Top-level tenant. Created in the same transaction as the first Owner user.
model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  sites           Site[]
  productGroups   ProductGroup[]
  products        Product[]
  productBarcodes ProductBarcode[]
  partners        Partner[]
  batches         Batch[]
  documents       Document[]
  documentCaptures DocumentCapture[]
  documentLines   DocumentLine[]
  supplierCodes   SupplierProductCode[]
  unitAliases     UnitAlias[]
  stockMovements  StockMovement[]
  activityLogs    ActivityLog[]
  invitations     Invitation[]
}

/// Physical location: store / kitchen / bar / warehouse (§4.1).
model Site {
  id            String    @id @default(uuid())
  companyId     String
  name          String
  type          SiteType  @default(STORE)
  address       String?
  managerUserId String?
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager         User?            @relation("SiteManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  userSites       UserSite[]
  documents       Document[]
  stockMovements  StockMovement[]
  invitationSites InvitationSite[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([managerUserId])
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sites       UserSite[]
  managedSites Site[]      @relation("SiteManager")
  activityLogs ActivityLog[]
  invitations Invitation[] @relation("InvitedBy")

  @@index([companyId])
}

/// Site managers and Staff only see assigned sites. Owner / Accountant skip this
/// table and receive allSites=true on the token.
model UserSite {
  userId     String
  siteId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@index([siteId])
}

/// Owner-issued invite; signup link is pre-tied to Company + role (+ optional sites).
model Invitation {
  id          String    @id @default(uuid())
  companyId   String
  email       String
  role        UserRole
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User             @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  sites     InvitationSite[]

  @@unique([companyId, email])
  @@index([companyId])
}

model InvitationSite {
  invitationId String
  siteId       String

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([invitationId, siteId])
}

// ---------------------------------------------------------------------------
// Master data (§4.1)
// ---------------------------------------------------------------------------

model ProductGroup {
  id        String   @id @default(uuid())
  companyId String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   ProductGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductGroup[] @relation("GroupTree")
  products Product[]

  @@index([companyId, parentId, name])
  @@index([companyId])
  @@index([parentId])
}

model Product {
  id             String        @id @default(uuid())
  companyId      String
  groupId        String?
  name           String
  code           String
  /// Canonical unit after alias lookup. OCR still stores the raw string on DocumentLine.ocrUnit.
  unit           UnitOfMeasure @default(PCS)
  /// Pieces (or kg) contained in one of `unit` — e.g. CASE of 20 pcs.
  packSize       Decimal       @default(1) @db.Decimal(12, 3)
  vatRate        Decimal       @db.Decimal(5, 2)
  purchasePrice  Decimal       @db.Decimal(12, 4)
  sellingPrice   Decimal       @db.Decimal(12, 4)
  minStock       Decimal       @default(0) @db.Decimal(12, 3)
  batchTracking  Boolean       @default(false)
  /// PENDING_REVIEW = auto-created from an invoice; bulk-review before treating as master data.
  status         ProductStatus @default(ACTIVE)
  createdFromDocumentId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group          ProductGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdFrom    Document?        @relation("ProductsCreatedFromDocument", fields: [createdFromDocumentId], references: [id], onDelete: SetNull)
  barcodes       ProductBarcode[]
  supplierCodes  SupplierProductCode[]
  batches        Batch[]
  documentLines  DocumentLine[]
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, status])
  @@index([groupId])
  @@index([createdFromDocumentId])
}

model ProductBarcode {
  id        String @id @default(uuid())
  companyId String
  productId String
  barcode   String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, barcode])
  @@index([productId])
}

/// Counterparty on a document. Role (supplier vs customer) comes from printed
/// field labels, never from position on the page — supplier templates vary.
model Partner {
  id        String      @id @default(uuid())
  companyId String
  kind      PartnerKind @default(SUPPLIER)
  name      String
  taxId       String?
  address     String?
  mol         String?
  phone       String?
  email       String?
  bankAccount String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents     Document[]
  supplierCodes SupplierProductCode[]

  @@index([companyId])
  @@unique([companyId, taxId])
}

/// Maps a supplier's printed product code onto our Product. Same SKU will have
/// a different code per supplier — do not store that code only on Product.
model SupplierProductCode {
  id            String   @id @default(uuid())
  companyId     String
  partnerId     String
  productId     String
  supplierCode  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, partnerId, supplierCode])
  @@index([productId])
  @@index([partnerId])
}

/// Raw unit strings from invoices ("бр.", "стек", "кашон", "пак") → enum.
/// Conversion to base pieces (case = 20 pcs) lives on Product.packSize.
model UnitAlias {
  id        String        @id @default(uuid())
  companyId String
  raw       String
  unit      UnitOfMeasure
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, raw])
  @@index([companyId])
}

/// Real invoices print batch number + expiry as separate columns per line.
/// expiryDate is required in application code when Product.batchTracking = true.
model Batch {
  id                String    @id @default(uuid())
  companyId         String
  productId         String
  batchNumber       String
  expiryDate        DateTime? @db.Date
  quantityRemaining Decimal   @default(0) @db.Decimal(12, 3)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  documentLines  DocumentLine[]
  stockMovements StockMovement[]

  @@unique([companyId, productId, batchNumber])
  @@index([companyId])
  @@index([productId])
  @@index([expiryDate])
}

// ---------------------------------------------------------------------------
// Documents & stock (§4.2)
// type maps to the four paper forms:
//   INVOICE     — търговски документ / purchase invoice (stock IN)
//   RECEIPT     — стокова разписка / goods receipt note (stock IN)
//   PROTOCOL    — складова разписка — изписване / handover or dispatch (stock OUT)
//   CREDIT_NOTE — кредитно/дебитно известие
// Extra photos of the same invoice attach as DocumentCapture pages — they are
// not a new Document.
// ---------------------------------------------------------------------------

model Document {
  id               String         @id @default(uuid())
  companyId        String
  siteId           String
  partnerId        String?
  type             DocumentType
  status           DocumentStatus @default(DRAFT)
  direction        StockDirection @default(IN)
  /// Printed "№" — documentNumber on the paper.
  number           String
  issuedOn         DateTime       @db.Date
  deliveryAddress  String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  postedAt         DateTime?

  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site             Site            @relation(fields: [siteId], references: [id], onDelete: Restrict)
  partner          Partner?        @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  lines            DocumentLine[]
  captures         DocumentCapture[]
  productsCreated  Product[]       @relation("ProductsCreatedFromDocument")
  stockMovements   StockMovement[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([siteId])
  @@index([partnerId])
}

/// One photographed page of a document (page 2 of a goods receipt, etc.).
model DocumentCapture {
  id                 String                   @id @default(uuid())
  companyId          String
  documentId         String
  pageNumber         Int                      @default(1)
  imageKey           String
  /// Valid extracted JSON only when extractionStatus = SUCCEEDED.
  ocrRaw             Json?
  extractionStatus   CaptureExtractionStatus  @default(IDLE)
  extractionError    String?
  /// GLM self-reported: high | medium | low
  confidence         String?
  createdAt          DateTime                 @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  lines    DocumentLine[]

  @@unique([documentId, pageNumber])
  @@index([companyId])
}

model DocumentLine {
  id                   String         @id @default(uuid())
  companyId            String
  documentId           String
  productId            String?
  batchId              String?
  position             Int            @default(0)
  /// Supplier's printed Код / № for this row (also stored on SupplierProductCode once matched).
  supplierProductCode  String?
  ocrDescription       String?
  ocrUnit              String?
  unit                 UnitOfMeasure?
  quantity             Decimal        @db.Decimal(12, 3)
  unitPrice            Decimal        @db.Decimal(12, 4)
  discountPercent      Decimal        @default(0) @db.Decimal(5, 2)
  finalUnitPrice       Decimal?       @db.Decimal(12, 4)
  lineTotal            Decimal?       @db.Decimal(12, 4)
  vatRate              Decimal        @db.Decimal(5, 2)
  ocrBatchNumber       String?
  ocrExpiryDate        DateTime?      @db.Date
  /// Staff checkmark on paper / line-level confirm on the review screen.
  verified             Boolean        @default(false)
  sourceCaptureId      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product       Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch         Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sourceCapture DocumentCapture? @relation(fields: [sourceCaptureId], references: [id], onDelete: SetNull)

  @@index([documentId])
  @@index([companyId])
  @@index([productId])
  @@index([documentId, verified])
  @@index([sourceCaptureId])
}

/// Immutable ledger. Do not update or delete rows from application code.
model StockMovement {
  id         String         @id @default(uuid())
  companyId  String
  siteId     String
  documentId String?
  productId  String
  batchId    String?
  direction  StockDirection
  quantity   Decimal        @db.Decimal(12, 3)
  occurredAt DateTime       @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site     Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch    Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([siteId, productId])
  @@index([documentId])
}

/// Generic mutation log (§4.9).
model ActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  userId     String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
}
